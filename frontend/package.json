{
  "name": "saas-catalogo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend público + panel admin de Saas Catalogo (Next.js App Router)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "cf:build": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "cf:preview": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "cf:deploy": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "wrangler": "^4.0.0"
  }
}
