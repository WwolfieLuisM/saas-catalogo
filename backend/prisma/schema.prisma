generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum SizeUnit {
  MB
  GB
  TB
}

enum Origin {
  BIBLIOTECA
  PERSONALIZADO
}

enum PriceMode {
  RULE
  MANUAL
}

model Tenant {
  id         String          @id @default(uuid())
  name       String
  slug       String          @unique
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  settings   TenantSettings?
  admins     AdminUser[]
  categories Category[]
  genres     Genre[]
  platforms  Platform[]
  games      TenantGame[]

  @@index([isActive])
}

model TenantSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String
  role         Role
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id])
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@index([tenantId])
  @@index([role])
}

model AdminSession {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([adminId])
  @@index([expiresAt])
}

model BaseGame {
  id                     String    @id @default(uuid())
  title                  String
  slug                   String    @unique
  description            String?
  sizeValue              Float
  sizeUnit               SizeUnit
  releaseYear            Int?
  categoryId             String?
  category               Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  minimumRequirements    Json?
  recommendedRequirements Json?
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  deletedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  genres                 BaseGameGenre[]
  platforms              BaseGamePlatform[]
  publications           TenantGame[]

  @@index([deletedAt])
}

model TenantGame {
  id                     String     @id @default(uuid())
  tenantId               String
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseGameId             String?
  baseGame               BaseGame?  @relation(fields: [baseGameId], references: [id], onDelete: Restrict)
  origin                 Origin
  title                  String
  slug                   String
  description            String?
  priceMode              PriceMode  @default(RULE)
  price                  Decimal?
  availability           Boolean    @default(true)
  sizeValue              Float
  sizeUnit               SizeUnit
  releaseYear            Int?
  categoryId             String?
  category               Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  minimumRequirements    Json?
  recommendedRequirements Json?
  createdBy              String?
  updatedBy              String?
  deletedBy              String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?
  genres                 TenantGameGenre[]
  platforms              GamePlatform[]

  @@unique([tenantId, slug])
  @@unique([tenantId, baseGameId])
  @@index([tenantId, deletedAt])
}

model Category {
  id          String       @id @default(uuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  baseGames   BaseGame[]
  games       TenantGame[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
}

model Genre {
  id          String             @id @default(uuid())
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  baseGames   BaseGameGenre[]
  games       TenantGameGenre[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
}

model Platform {
  id          String             @id @default(uuid())
  tenantId    String?
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  baseGames   BaseGamePlatform[]
  games       GamePlatform[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
}

model BaseGameGenre {
  baseGameId String
  genreId    String
  baseGame   BaseGame @relation(fields: [baseGameId], references: [id], onDelete: Cascade)
  genre      Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([baseGameId, genreId])
}

model BaseGamePlatform {
  baseGameId String
  platformId String
  baseGame   BaseGame @relation(fields: [baseGameId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([baseGameId, platformId])
}

model TenantGameGenre {
  tenantGameId String
  genreId      String
  tenantGame   TenantGame @relation(fields: [tenantGameId], references: [id], onDelete: Cascade)
  genre        Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([tenantGameId, genreId])
}

model GamePlatform {
  tenantGameId String
  platformId   String
  tenantGame   TenantGame @relation(fields: [tenantGameId], references: [id], onDelete: Cascade)
  platform     Platform   @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([tenantGameId, platformId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole Role?
  tenantId  String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([timestamp])
}
